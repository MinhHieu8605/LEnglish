# =============================================
# PostgreSQL Database Configuration
# =============================================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=learn-english
DB_PORT=5432

# =============================================
# Connection Pool
# pool_size     = số kết nối giữ sẵn
# max_overflow  = kết nối tạm thêm khi pool đầy
# pool_recycle  = tái tạo kết nối sau N giây (tránh kết nối chết)
# pool_timeout  = chờ tối đa N giây khi pool đầy
# =============================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

#JWT
ACCESS-TOKEN-EXPIRE=60
JWT-ALG=HS256
Refresh-TOKEN-EXPIRE=1440
